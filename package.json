{
  "name": "vfq-dxp-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "sync:news": "node --use-system-ca scripts/sync-news.mjs",
    "predev": "node --use-system-ca scripts/sync-news.mjs --soft",
    "prebuild": "node --use-system-ca scripts/sync-news.mjs --soft",
    "dev": "next dev -p ${PORT:-5180}",
    "dev:tablet": "npm run view:tablet",
    "view:tablet": "node scripts/device-view.mjs tablet",
    "view:mobile": "node scripts/device-view.mjs mobile",
    "dev:mobile": "npm run view:mobile",
    "dev:all": "PORT=5180 npm run dev & TABLET_PORT=5174 npm run view:tablet & MOBILE_PORT=5175 npm run view:mobile & wait",
    "open:web": "node scripts/open-views.mjs web",
    "open:tablet": "node scripts/open-views.mjs tablet",
    "open:mobile": "node scripts/open-views.mjs mobile",
    "open:all": "node scripts/open-views.mjs all",
    "build": "tsc -b && next build",
    "lint": "oxlint",
    "test": "node --test tests/*.test.mjs",
    "start": "next start -p ${PORT:-5173}",
    "test:e2e": "playwright test",
    "sync:customers": "python3 reference/scripts/build_customer_inventory.py --seed && python3 reference/scripts/build_customer_inventory.py && python3 reference/scripts/verify_customer_inventory_sync.py",
    "verify:customers": "python3 reference/scripts/verify_customer_inventory_sync.py",
    "sync:caf-content": "python3 reference/scripts/build_caf_content.py",
    "verify:caf-content": "python3 reference/scripts/build_caf_content.py --check",
    "storybook": "storybook dev -p ${SB_PORT:-6006}",
    "build-storybook": "storybook build -o storybook-static",
    "storybook:serve": "npx http-server storybook-static -p ${SB_PORT:-6006}",
    "test-storybook": "vitest run",
    "storybook:typecheck": "tsc -p tsconfig.storybook.json --noEmit",
    "storybook:typecheck:stubs": "tsc -p .storybook/typecheck/tsconfig.json --noEmit",
    "storybook:coverage": "node scripts/storybook-coverage.mjs",
    "lib:install": "node scripts/install-library.mjs"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.14.0",
    "@tailwindcss/postcss": "^4.3.3",
    "immer": "^11.2.9",
    "lucide-react": "^1.70.0",
    "next": "^16.4.5",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-redux": "^9.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.0",
    "@storybook/addon-a11y": "^10.0.0",
    "@storybook/addon-docs": "^10.0.0",
    "@storybook/addon-vitest": "^10.0.0",
    "@storybook/react-vite": "^10.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/browser-playwright": "^4.0.0",
    "@vitest/coverage-v8": "^4.0.0",
    "oxlint": "^1.75.0",
    "playwright": "^1.65.0",
    "storybook": "^10.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.0.0"
  },
  "dxpUi": {
    "package": "@vfq/dxp-ui",
    "version": "^0.1.0"
  }
}
